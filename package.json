{
  "name": "crypto-engram-llm-wiki",
  "version": "0.1.0",
  "description": "Crypto Engram LLM-Wiki — a personalized crypto/AI knowledge brain: an LLM-maintained wiki fed by an always-on, pre-scored news firehose.",
  "type": "module",
  "private": true,
  "scripts": {
    "setup-vault": "node scripts/setup-vault.js",
    "ingest:manual": "node scripts/ingest-manual.js",
    "ingest:web-clipper": "node scripts/ingest-web-clipper.js",
    "ingest:mock": "node scripts/ingest-mock.js",
    "ingest:opennews": "node --env-file-if-exists=.env scripts/ingest-opennews.js",
    "lint:wiki": "node scripts/lint-wiki.js",
    "bot:start": "node --env-file-if-exists=.env scripts/bot-start.js",
    "digest": "node scripts/digest.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
