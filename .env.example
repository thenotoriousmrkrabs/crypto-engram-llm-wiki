# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# Tests never need these; all network/Discord I/O is faked in the suite.

CONTENT_INTELLIGENCE_VAULT_PATH=./vault/Content_Intelligence_Vault

# 6551 premium API bearer token (from https://6551.io/mcp)
OPENNEWS_TOKEN=your-6551-token-here

# Discord bot token (Discord Developer Portal -> your app -> Bot)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Channel the bot posts opennews items into (right-click channel -> Copy ID)
DISCORD_CHANNEL_ID=your-channel-id-here

# Quality floor: only pull articles whose AI score is >= this (0-100).
# Default 70 (broad but high-quality). Set 0 to disable and pull everything.
FIREHOSE_MIN_SCORE=70

# Curated feed = a coin-list pull UNION one full-text pull per theme, deduped.
# Nothing outside these lists reaches the channel. Comma-separated. Leave a
# line unset to use the built-in default list; set it to `none` to drop that
# half of the feed (e.g. FIREHOSE_THEMES=none for a coins-only feed).
# FIREHOSE_COINS=HYPE,BTC,BNB,ETH,SOL,USDT,USDC,ZEC,USDS,USDe
# FIREHOSE_THEMES=HIP-4,stablecoin,prediction market,Polymarket,Kalshi,Hyperliquid,HIP-3,neobank,crypto cards,Collector Crypt,TradFi,PerpDex,DeFi,Yield,Base,Robinhood,RWAs,Smart Contract,Layer 1,Layer 2,CEX,Wallet,Listings,Memecoin,MiCA,Privacy,Governance,Perpetuals,Onchain data,x402,Lending,Borrowing,Vault

# Reading-surface languages to POST (comma-separated). Default en,zh.
# Other-language items are still stored/seen, just not posted. Use `all` to
# post every language.
FIREHOSE_LANGS=en,zh

# Optional: minutes between pulls (default 360 = 4x/day). Each tick pages back
# until it reaches already-seen items, so a longer gap does not drop news as
# long as no single query exceeds FIREHOSE_MAX_PAGES x 100 items in the gap.
# FIREHOSE_PULL_INTERVAL_MINUTES=360

# Optional: max pages each query walks back per tick (default 3 = 300-item
# margin per query). Raise if a hot coin/theme ever overflows a 6h gap.
# FIREHOSE_MAX_PAGES=3
