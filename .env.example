# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# Tests never need these; all network/Discord I/O is faked in the suite.

CONTENT_INTELLIGENCE_VAULT_PATH=./vault/Content_Intelligence_Vault

# 6551 premium API bearer token (from https://6551.io/mcp)
OPENNEWS_TOKEN=your-6551-token-here

# Discord bot token (Discord Developer Portal -> your app -> Bot)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Channel the bot posts opennews items into (right-click channel -> Copy ID)
DISCORD_CHANNEL_ID=your-channel-id-here
